.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 48rpx;
  text-align: center;
}

.preview {
  width: 100%;
  height: 700rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  margin-bottom: 48rpx;
}

.btn-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.btn-row button {
  flex: 1;
}

.primary-btn {
  background: #07c160;
  color: #fff;
}

.secondary-btn {
  background: #f2f2f2;
  color: #333;
}
